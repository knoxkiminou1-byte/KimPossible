# Contact form email delivery (api/contact.js).
# Without GMAIL_APP_PASSWORD set, the contact form returns a 503 with a
# fallbackEmail instead of attempting to send.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=you@gmail.com

# Optional: Cloudflare Turnstile bot protection for the contact form.
# Leave both unset to disable Turnstile entirely (the form works normally,
# just without the extra verification step). If you set one, set both —
# TURNSTILE_SECRET_KEY is checked server-side; VITE_TURNSTILE_SITE_KEY is
# read at build time by the frontend to render the widget.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Admin-protected routes (currently unused — /admin/blog was removed
# until a real backend exists; see artifacts/api-server for the
# Express server this would apply to if it's ever deployed).
ADMIN_SECRET=

# Postgres connection string for lib/db (Drizzle). The schema is
# currently empty — only needed once real tables are added.
DATABASE_URL=
